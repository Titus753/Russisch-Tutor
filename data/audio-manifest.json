    "ges-011": {
      "hash": "5de47ba0f1fa41bd",
      "text": "Помогите!"
    },
    "ges-012": {
      "hash": "1aabd0d5887e8eca",
      "text": "Вызовите скорую!"
    },
    "ges-013": {
      "hash": "08f51b54889bda52",
      "text": "У меня болит голова."
    },
    "ges-014": {
      "hash": "87bbf95d90cf6742",
      "text": "Мне плохо."
    },
    "ges-015": {
      "hash": "0d45ee9c6f220d60",
      "text": "Где ближайшая аптека?"
    },
    "ges-016": {
      "hash": "faac046303734e10",
      "text": "У меня аллергия на орехи."
    },
    "ges-017": {
      "hash": "263bbeabce58814d",
      "text": "Мне нужен врач."
    },
    "ges-018": {
      "hash": "ee350dcf47887fe9",
      "text": "Я заболел. Я заболела."
    },
    "ges-019": {
      "hash": "5c6fa1944cee8b33",
      "text": "Выздоравливайте!"
    },
    "ges-020": {
      "hash": "7aa00ab0ef3d164c",
      "text": "Будьте здоровы!"
    },
    "kle-001": {
      "hash": "ff8a9c3d9c4559e3",
      "text": "оде́жда"
    },
    "kle-002": {
      "hash": "3f9346000c29b316",
      "text": "руба́шка"
    },
    "kle-003": {
      "hash": "ebcef2f2e985071a",
      "text": "пла́тье"
    },
    "kle-004": {
      "hash": "ed5656c7f3638dff",
      "text": "брю́ки"
    },
    "kle-005": {
      "hash": "619737ea93c1a348",
      "text": "ку́ртка"
    },
    "kle-006": {
      "hash": "1e9fee8620a28734",
      "text": "о́бувь"
    },
    "kle-007": {
      "hash": "eaa7b3a630cdbe92",
      "text": "ша́пка"
    },
    "kle-008": {
      "hash": "72acbc7df8d6ecc3",
      "text": "кра́сный"
    },
    "kle-009": {
      "hash": "74e33287d4cb9a12",
      "text": "си́ний"
    },
    "kle-010": {
      "hash": "19aa62c7c3c05142",
      "text": "голубо́й"
    },
    "kle-011": {
      "hash": "1d361e1d8fc89217",
      "text": "зелёный"
    },
    "kle-012": {
      "hash": "5f8e99c3731c039b",
      "text": "жёлтый"
    },
    "kle-013": {
      "hash": "10d5d1f22f8d8c91",
      "text": "бе́лый"
    },
    "kle-014": {
      "hash": "d222c671bdd11610",
      "text": "чёрный"
    },
    "kle-015": {
      "hash": "8eda8452f4c09fee",
      "text": "разме́р"
    },
    "kle-016": {
      "hash": "53fc5c669205ea33",
      "text": "Можно примерить?"
    },
    "kle-017": {
      "hash": "6b915d557399a0ff",
      "text": "Где примерочная?"
    },
    "kle-018": {
      "hash": "0985794685c35bb2",
      "text": "Есть размер побольше?"
    },
    "kle-019": {
      "hash": "03172f4b546f4574",
      "text": "Это мне мало."
    },
    "kle-020": {
      "hash": "0f90687f4d50b1ee",
      "text": "Этот цвет мне нравится."
    },
    "koc-001": {
      "hash": "3cc98d9c20358a4e",
      "text": "кастрю́ля"
    },
    "koc-002": {
      "hash": "776beed630ce5e49",
      "text": "сковорода́"
    },
    "koc-003": {
      "hash": "82d2a7dc278b8859",
      "text": "нож"
    },
    "koc-004": {
      "hash": "74283b83bbbb801e",
      "text": "ло́жка"
    },
    "koc-005": {
      "hash": "a4fdd86186d9aca4",
      "text": "ви́лка"
    },
    "koc-006": {
      "hash": "00206a6b98593bc9",
      "text": "таре́лка"
    },
    "koc-007": {
      "hash": "09621817fa13291f",
      "text": "соль"
    },
    "koc-008": {
      "hash": "51ef40bb16cbb329",
      "text": "са́хар"
    },
    "koc-009": {
      "hash": "c891f9eaa39e3ddd",
      "text": "ма́сло"
    },
    "koc-010": {
      "hash": "5251742636eba710",
      "text": "яйцо́"
    },
    "koc-011": {
      "hash": "66f0d7c6577749e7",
      "text": "мя́со"
    },
    "koc-012": {
      "hash": "38d13b091627d6a2",
      "text": "ры́ба"
    },
    "koc-013": {
      "hash": "1c7526d5ab6d1b66",
      "text": "о́вощи"
    },
    "koc-014": {
      "hash": "86f80b7184e3932a",
      "text": "карто́шка"
    },
    "koc-015": {
      "hash": "3d7ca73de70c213a",
      "text": "суп"
    },
    "koc-016": {
      "hash": "0b027e8673f37eb6",
      "text": "Порежьте лук."
    },
    "koc-017": {
      "hash": "e5a0a5f105c04d30",
      "text": "Вода кипит."
    },
    "koc-018": {
      "hash": "49bc18e398812302",
      "text": "Добавьте немного соли."
    },
    "koc-019": {
      "hash": "40768d1f56faa954",
      "text": "Что будем готовить?"
    },
    "koc-020": {
      "hash": "6a9b498eddb11b14",
      "text": "Аппетит приходит во время еды."
    },
    "koe-001": {
      "hash": "b06bee0db3cf1e7b",
      "text": "голова́"
    },
    "koe-002": {
      "hash": "9dfb0ac50754a827",
      "text": "глаз"
    },
    "koe-003": {
      "hash": "aa8744db132fe80b",
      "text": "у́хо"
    },
    "koe-004": {
      "hash": "45a51a8636277759",
      "text": "нос"
    },
    "koe-005": {
      "hash": "aa2b896cf7c3b716",
      "text": "рот"
    },
    "koe-006": {
      "hash": "7b03cd8f0bf77723",
      "text": "зуб"
    },
    "koe-007": {
      "hash": "c4c98e39632690c9",
      "text": "рука́"
    },
    "koe-008": {
      "hash": "9fc1554a8a22191c",
      "text": "нога́"
    },
    "koe-009": {
      "hash": "ea1a8d3e7fe5b242",
      "text": "спина́"
    },
    "koe-010": {
      "hash": "337583505cfd8c44",
      "text": "живо́т"
    },
    "koe-011": {
      "hash": "035178f425bf3327",
      "text": "се́рдце"
    },
    "koe-012": {
      "hash": "f9b46f6939c00ed1",
      "text": "па́лец"
    },
    "koe-013": {
      "hash": "86e12cf6bbe7cbf8",
      "text": "во́лосы"
    },
    "koe-014": {
      "hash": "464a0f4016233f17",
      "text": "лицо́"
    },
    "koe-015": {
      "hash": "4ddb44d3cce4a5ff",
      "text": "го́рло"
    },
    "koe-016": {
      "hash": "13bb5e252e77cb31",
      "text": "У меня болит зуб."
    },
    "koe-017": {
      "hash": "1c1b185cca850fa5",
      "text": "У меня болит спина."
    },
    "koe-018": {
      "hash": "47dc77d1fc446413",
      "text": "Я сломал руку. Я сломала руку."
    },
    "koe-019": {
      "hash": "fa5362ac1af1d4e8",
      "text": "У него голубые глаза."
    },
    "koe-020": {
      "hash": "98040409994c358b",
      "text": "Язык до Киева доведёт."
    },
    "red-001": {
      "hash": "7cffd3b9e809b03e",
      "text": "Первый блин комом."
    },
    "red-002": {
      "hash": "70d7aaba3488055e",
      "text": "Тише едешь — дальше будешь."
    },
    "red-003": {
      "hash": "abb5e9a6ae1fd867",
      "text": "Не всё то золото, что блестит."
    },
    "red-004": {
      "hash": "4c9d6bf4409f2bed",
      "text": "Лучше поздно, чем никогда."
    },
    "red-005": {
      "hash": "8e099d80d3177a19",
      "text": "Век живи — век учись."
    },
    "red-006": {
      "hash": "f18029ca684749d4",
      "text": "Поживём — увидим."
    },
    "red-007": {
      "hash": "d9e47389ff21d04e",
      "text": "Утро вечера мудренее."
    },
    "red-008": {
      "hash": "5e13609652e54336",
      "text": "Старый друг лучше новых двух."
    },
    "red-009": {
      "hash": "28f96b1fee97ed6b",
      "text": "Ни пуха ни пера!"
    },
    "red-010": {
      "hash": "1502a3e6b4c9f48b",
      "text": "Всё хорошо, что хорошо кончается."
    },
    "red-011": {
      "hash": "2d318c5a69db7627",
      "text": "Москва не сразу строилась."
    },
    "red-012": {
      "hash": "8bcf88d228a1fbd8",
      "text": "Не имей сто рублей, а имей сто друзей."
    },
    "red-013": {
      "hash": "7200d0bf0c9d2d61",
      "text": "Где тонко, там и рвётся."
    },
    "red-014": {
      "hash": "3d9deedadc64b1af",
      "text": "Слово не воробей, вылетит — не поймаешь."
    },
    "red-015": {
      "hash": "6a6737a5e2e3e6a9",
      "text": "Глаза боятся, а руки делают."
    },
    "red-016": {
      "hash": "c1bdaccd53d6aea2",
      "text": "Семь раз отмерь, один раз отрежь."
    },
    "red-017": {
      "hash": "21675d586cf023b7",
      "text": "В тихом омуте черти водятся."
    },
    "red-018": {
      "hash": "c91d1e57e4f63121",
      "text": "Дарёному коню в зубы не смотрят."
    },
    "red-019": {
      "hash": "154e403144fd5351",
      "text": "Как по маслу."
    },
    "red-020": {
      "hash": "324d476c9d55811a",
      "text": "Вешать лапшу на уши."
    },
    "res-001": {
      "hash": "040a4178247fd216",
      "text": "меню́"
    },
    "res-002": {
      "hash": "8d5b7b9ea4db41ab",
      "text": "счёт"
    },
    "res-003": {
      "hash": "503c5eb5216b99b9",
      "text": "официа́нт"
    },
    "res-004": {
      "hash": "90da7d317fa265b0",
      "text": "чай"
    },
    "res-005": {
      "hash": "0a76aed13edd1fba",
      "text": "ко́фе"
    },
    "res-006": {
      "hash": "b9cb0fad7dab490c",
      "text": "вода́"
    },
    "res-007": {
      "hash": "c550f6aee915c30f",
      "text": "вино́"
    },
    "res-008": {
      "hash": "35200d3c805e4871",
      "text": "пи́во"
    },
    "res-009": {
      "hash": "ef82a92f23636133",
      "text": "за́втрак"
    },
    "res-010": {
      "hash": "5c6cb5daaabf14a0",
      "text": "обе́д"
    },
    "res-011": {
      "hash": "574fd3c558710fa3",
      "text": "у́жин"
    },
    "res-012": {
      "hash": "0dd4ab8da730d5f4",
      "text": "Столик на двоих, пожалуйста."
    },
    "res-013": {
      "hash": "192a9c1ec352a07f",
      "text": "Счёт, пожалуйста."
    },
    "res-014": {
      "hash": "1e2d111f42583a77",
      "text": "Что вы посоветуете?"
    },
    "res-015": {
      "hash": "eca1d1fad47c43ac",
      "text": "Я не ем мясо."
    },
    "res-016": {
      "hash": "8e1b007094cc135f",
      "text": "Можно меню?"
    },
    "res-017": {
      "hash": "d10a3ee6f2a25ba2",
      "text": "Было очень вкусно!"
    },
    "res-018": {
      "hash": "8b9a631c6bec9aea",
      "text": "Кофе с молоком, пожалуйста."
    },
    "res-019": {
      "hash": "67a372d5cc4815bd",
      "text": "Приятного аппетита!"
    },
    "res-020": {
      "hash": "6cdcee42f08dd423",
      "text": "На здоровье!"
    },
    "tel-001": {
      "hash": "03ac596ec69a18da",
      "text": "телефо́н"
    },
    "tel-002": {
      "hash": "75f0ade34e1ccf73",
      "text": "но́мер телефо́на"
    },
    "tel-003": {
      "hash": "43a9b5b8aa851271",
      "text": "сообще́ние"
    },
    "tel-004": {
      "hash": "2fa63ef9e52ec63a",
      "text": "паро́ль"
    },
    "tel-005": {
      "hash": "1070517193da6206",
      "text": "заря́дка"
    },
    "tel-006": {
      "hash": "5be379e19ea5ac9b",
      "text": "интерне́т"
    },
    "tel-007": {
      "hash": "fd4722d2d29ede14",
      "text": "сайт"
    },
    "tel-008": {
      "hash": "c085c8007ce48999",
      "text": "электро́нная по́чта"
    },
    "tel-009": {
      "hash": "defca2d94f45ca5a",
      "text": "приложе́ние"
    },
    "tel-010": {
      "hash": "cd3a077702d35004",
      "text": "Алло́!"
    },
    "tel-011": {
      "hash": "1837c8266b12f917",
      "text": "Можно позвонить?"
    },
    "tel-012": {
      "hash": "b1fee0afda686336",
      "text": "Перезвоните мне, пожалуйста."
    },
    "tel-013": {
      "hash": "62658b34da57b638",
      "text": "Какой пароль от вай-фая?"
    },
    "tel-014": {
      "hash": "92e5a1c829ed5eeb",
      "text": "У меня сел телефон."
    },
    "tel-015": {
      "hash": "35c91c6fc253832e",
      "text": "Напишите мне."
    },
    "tel-016": {
      "hash": "95e8ff670012bed9",
      "text": "Я вам позвоню."
    },
    "tel-017": {
      "hash": "021f9deac2408be3",
      "text": "Плохая связь."
    },
    "tel-018": {
      "hash": "8c72677634957ed2",
      "text": "Вас не слышно."
    },
    "tel-019": {
      "hash": "07f14c618cec2b74",
      "text": "Кто говорит?"
    },
    "tel-020": {
      "hash": "4b19727fcaf536d4",
      "text": "Вы ошиблись номером."
    },
    "tie-001": {
      "hash": "6b7a718838d974f1",
      "text": "соба́ка"
    },
    "tie-002": {
      "hash": "51d904195613619d",
      "text": "ко́шка"
    },
    "tie-003": {
      "hash": "57becedc25cbb5a5",
      "text": "ло́шадь"
    },
    "tie-004": {
      "hash": "7b36c41cdb97c50e",
      "text": "коро́ва"
    },
    "tie-005": {
      "hash": "229043086f2ee339",
      "text": "пти́ца"
    },
    "tie-006": {
      "hash": "ffb367cdddfc2cf7",
      "text": "медве́дь"
    },
    "tie-007": {
      "hash": "73509f9096fea6df",
      "text": "волк"
    },
    "tie-008": {
      "hash": "b074f14a5956cf6a",
      "text": "лиса́"
    },
    "tie-009": {
      "hash": "1ba6bac97dcec2ef",
      "text": "за́яц"
    },
    "tie-010": {
      "hash": "b4413dbddd352dfa",
      "text": "мышь"
    },
    "tie-011": {
      "hash": "898b3cdc8f5ee08f",
      "text": "свинья́"
    },
    "tie-012": {
      "hash": "4aa6973bb4b6cd72",
      "text": "ку́рица"
    },
    "tie-013": {
      "hash": "8f095341d99849d6",
      "text": "У тебя есть домашние животные?"
    },
    "tie-014": {
      "hash": "373e6a62e63e2e8c",
      "text": "У меня есть собака."
    },
    "tie-015": {
      "hash": "d5fbdaa863cd5e67",
      "text": "Можно погладить?"
    },
    "tie-016": {
      "hash": "8263ce5488f3ec0a",
      "text": "Осторожно, злая собака!"
    },
    "tie-017": {
      "hash": "bc9d513698d556c6",
      "text": "Кошка спит на диване."
    },
    "tie-018": {
      "hash": "43a1715f708ef31e",
      "text": "Волков бояться — в лес не ходить."
    },
    "tie-019": {
      "hash": "24f6f11f6dfb8dfe",
      "text": "Голоден как волк."
    },
    "tie-020": {
      "hash": "a95c6c276818cbf9",
      "text": "Когда рак на горе свистнет."
    },
    "unt-001": {
      "hash": "f5657106ffe23f24",
      "text": "по́езд"
    },
    "unt-002": {
      "hash": "588577ee500b02d5",
      "text": "вокза́л"
    },
    "unt-003": {
      "hash": "443df2ff3ce9c1c5",
      "text": "биле́т"
    },
    "unt-004": {
      "hash": "3bbe02d8ed797a5c",
      "text": "авто́бус"
    },
    "unt-005": {
      "hash": "105ac9b462a74e2e",
      "text": "остано́вка"
    },
    "unt-006": {
      "hash": "028be02a6ab5ba26",
      "text": "метро́"
    },
    "unt-007": {
      "hash": "1b31c032b6ca310d",
      "text": "такси́"
    },
    "unt-008": {
      "hash": "4bd71b10c073d040",
      "text": "самолёт"
    },
    "unt-009": {
      "hash": "c0af66a0cfa218cd",
      "text": "аэропо́рт"
    },
    "unt-010": {
      "hash": "6d3f9f73e0e588c8",
      "text": "у́лица"
    },
    "unt-011": {
      "hash": "67c684bf361ed40c",
      "text": "нале́во"
    },
    "unt-012": {
      "hash": "2f11a5481eb07e10",
      "text": "напра́во"
    },
    "unt-013": {
      "hash": "8e79b1c4f56c1168",
      "text": "пря́мо"
    },
    "unt-014": {
      "hash": "e904a77ff55139d5",
      "text": "Где находится вокзал?"
    },
    "unt-015": {
      "hash": "ce654609cd72da43",
      "text": "Как пройти к метро?"
    },
    "unt-016": {
      "hash": "e67fabd496a53c5f",
      "text": "Один билет до Москвы, пожалуйста."
    },
    "unt-017": {
      "hash": "13cbec2bcd226a9c",
      "text": "Когда отправляется поезд?"
    },
    "unt-018": {
      "hash": "3aae85495700ed8a",
      "text": "Это далеко?"
    },
    "unt-019": {
      "hash": "1b01929ecc2c5013",
      "text": "Остановите здесь, пожалуйста."
    },
    "unt-020": {
      "hash": "f9d4743952766cc4",
      "text": "Я заблудился. Я заблудилась."
    },
    "wet-001": {
      "hash": "83c0dfbfcb2e1977",
      "text": "пого́да"
    },
    "wet-002": {
      "hash": "3c771fe88f9e37f5",
      "text": "со́лнце"
    },
    "wet-003": {
      "hash": "acc4a81e7dd0e781",
      "text": "дождь"
    },
    "wet-004": {
      "hash": "a16e35f2971351f1",
      "text": "снег"
    },
    "wet-005": {
      "hash": "edc78175e0b8d64b",
      "text": "ве́тер"
    },
    "wet-006": {
      "hash": "61d03c66d4dae479",
      "text": "хо́лодно"
    },
    "wet-007": {
      "hash": "ad93443212a8167b",
      "text": "тепло́"
    },
    "wet-008": {
      "hash": "f04c14bfb42accb4",
      "text": "жа́рко"
    },
    "wet-009": {
      "hash": "c205d25caa0d07c0",
      "text": "о́блако"
    },
    "wet-010": {
      "hash": "134fe25aded04a96",
      "text": "не́бо"
    },
    "wet-011": {
      "hash": "2bd91ede6bf44f65",
      "text": "мо́ре"
    },
    "wet-012": {
      "hash": "47e85765844b7798",
      "text": "река́"
    },
    "wet-013": {
      "hash": "46feef2fdc896453",
      "text": "лес"
    },
    "wet-014": {
      "hash": "69616e475a5bfc41",
      "text": "гора́"
    },
    "wet-015": {
      "hash": "5eecc7233cdcc073",
      "text": "Какая сегодня погода?"
    },
    "wet-016": {
      "hash": "0bf12093c91e3501",
      "text": "Идёт дождь."
    },
    "wet-017": {
      "hash": "6092300e3de851ad",
      "text": "Сегодня холодно."
    },
    "wet-018": {
      "hash": "b4ad8f7c236b6a3c",
      "text": "Завтра будет солнечно."
    },
    "wet-019": {
      "hash": "d8d02a03fa1363e0",
      "text": "Мне жарко."
    },
    "wet-020": {
      "hash": "407a037114583b5a",
      "text": "После дождичка в четверг."
    },
    "woh-001": {
      "hash": "767f1c87456771a2",
      "text": "гости́ница"
    },
    "woh-002": {
      "hash": "439fa0919692d0bc",
      "text": "но́мер"
    },
    "woh-003": {
      "hash": "11e8e932b9b535b1",
      "text": "ключ"
    },
    "woh-004": {
      "hash": "965f0b374f8848f8",
      "text": "кварти́ра"
    },
    "woh-005": {
      "hash": "19e2408c162f2872",
      "text": "дом"
    },
    "woh-006": {
      "hash": "cad750925b25b5aa",
      "text": "ку́хня"
    },
    "woh-007": {
      "hash": "402ce592d3abc059",
      "text": "ва́нная"
    },
    "woh-008": {
      "hash": "3dd8f290ab4bfcc2",
      "text": "крова́ть"
    },
    "woh-009": {
      "hash": "ad8ab2edec43ad4a",
      "text": "окно́"
    },
    "woh-010": {
      "hash": "dc57164fd437a8e2",
      "text": "дверь"
    },
    "woh-011": {
      "hash": "b9d86b50736b1eef",
      "text": "эта́ж"
    },
    "woh-012": {
      "hash": "905f5ebac7adbe98",
      "text": "лифт"
    },
    "woh-013": {
      "hash": "688257646795fa86",
      "text": "У меня забронирован номер."
    },
    "woh-014": {
      "hash": "440d25629a86a3a5",
      "text": "Во сколько завтрак?"
    },
    "woh-015": {
      "hash": "e39dce76d1fc2dd3",
      "text": "В номере не работает душ."
    },
    "woh-016": {
      "hash": "8f4a4ce54d5fcd7f",
      "text": "Можно поздний выезд?"
    },
    "woh-017": {
      "hash": "b52142518250ce8b",
      "text": "Где лифт?"
    },
    "woh-018": {
      "hash": "24fc6acbf934a273",
      "text": "Я хочу снять квартиру."
    },
    "woh-019": {
      "hash": "95bd000bc0701e08",
      "text": "Мой дом — моя крепость."
    },
    "woh-020": {
      "hash": "dadd0bd93cdcd936",
      "text": "В гостях хорошо, а дома лучше."
    },
    "zah-001": {
      "hash": "400ad9b32e0b4c32",
      "text": "оди́н"
    },
    "zah-002": {
      "hash": "082b7fd6e72ce171",
      "text": "два"
    },
    "zah-003": {
      "hash": "889198c2185bbbaa",
      "text": "три"
    },
    "zah-004": {
      "hash": "1af45f620ba24399",
      "text": "четы́ре"
    },
    "zah-005": {
      "hash": "84489de502c78f27",
      "text": "пять"
    },
    "zah-006": {
      "hash": "400389c3d530b15d",
      "text": "де́сять"
    },
    "zah-007": {
      "hash": "da9e1f959375705b",
      "text": "сто"
    },
    "zah-008": {
      "hash": "c6a32e0832e59378",
      "text": "ты́сяча"
    },
    "zah-009": {
      "hash": "750fadc86dac2415",
      "text": "сего́дня"
    },
    "zah-010": {
      "hash": "5ed75f1d354ac3af",
      "text": "за́втра"
    },
    "zah-011": {
      "hash": "a8d199161dda5f44",
      "text": "вчера́"
    },
    "zah-012": {
      "hash": "89d6054cc5feb50b",
      "text": "неде́ля"
    },
    "zah-013": {
      "hash": "8dce7a0f0ea28263",
      "text": "час"
    },
    "zah-014": {
      "hash": "3129de63bd06b51f",
      "text": "мину́та"
    },
    "zah-015": {
      "hash": "885612f91e689171",
      "text": "понеде́льник"
    },
    "zah-016": {
      "hash": "7dda66ff47d71d7e",
      "text": "пя́тница"
    },
    "zah-017": {
      "hash": "45e19841a14429fa",
      "text": "Который час?"
    },
    "zah-018": {
      "hash": "87985c38a259d9a6",
      "text": "Сейчас три часа."
    },
    "zah-019": {
      "hash": "77cf029dad211843",
      "text": "Во сколько?"
    },
    "zah-020": {
      "hash": "2dc09e6bc68cc25c",
      "text": "Мне двадцать пять лет."
    }
  }
}

  {
    "id": "red-009",
    "typ": "redewendung",
    "thema": "redewendungen",
    "russisch": "Ни пуха ни пера!",
    "deutsch": "Hals- und Beinbruch!",
    "hinweis": "Antwort: К чёрту!"

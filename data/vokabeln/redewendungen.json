  {
    "id": "red-004",
    "typ": "redewendung",
    "thema": "redewendungen",
    "russisch": "Лучше поздно, чем никогда.",
    "deutsch": "Besser spät als nie."
  },
  {
    "id": "red-005",
    "typ": "redewendung",
    "thema": "redewendungen",
    "russisch": "Век живи — век учись.",
    "deutsch": "Man lernt nie aus."
  },
  {
    "id": "red-006",
    "typ": "redewendung",
    "thema": "redewendungen",
    "russisch": "Поживём — увидим.",
    "deutsch": "Abwarten und Tee trinken."
  },
  {
    "id": "red-007",
    "typ": "redewendung",
    "thema": "redewendungen",
    "russisch": "Утро вечера мудренее.",
    "deutsch": "Guter Rat kommt über Nacht."

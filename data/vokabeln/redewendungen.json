[
  {
    "id": "red-001",
    "typ": "redewendung",
    "thema": "redewendungen",
    "russisch": "Первый блин комом.",
    "deutsch": "Aller Anfang ist schwer."
  },
  {
    "id": "red-002",
    "typ": "redewendung",
    "thema": "redewendungen",
    "russisch": "Тише едешь — дальше будешь.",
